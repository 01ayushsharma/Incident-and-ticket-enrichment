# ---------------------------------------------------------------------------
# Incident and Ticket Enrichment Copilot - sample configuration
# Copy to .env and adjust. NEVER commit a real .env.
# Every value below has a working default: `docker compose up --build` runs
# end-to-end with no edits and no third-party API key.
# ---------------------------------------------------------------------------

# --- Alarm Management API simulator (source system) ------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=demo-token
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=3
# Deterministic seed for the simulator's synthetic dataset.
ALARM_API_SEED=20260501

# --- Mock ticketing API (write target) -------------------------------------
TICKETING_API_URL=http://ticketing-api:8100
TICKETING_API_TOKEN=demo-ticket-token

# --- MCP server -------------------------------------------------------------
# Transport used by the copilot's MCP client: "stdio" or "http".
MCP_TRANSPORT=http
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_TOOL_TIMEOUT_SECONDS=30

# --- Copilot backend --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
LOG_LEVEL=INFO
# Structured JSON logs (recommended) or human-readable console logs.
LOG_FORMAT=json

# --- LLM provider -----------------------------------------------------------
# One of: fake | ollama | gemini | anthropic | openai
# "fake" is the default: a deterministic, offline provider used by the test
# suite and CI. It requires no key and keeps the whole stack runnable cold.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
# Retries for 429 / 5xx / network errors (exponential backoff, honours Retry-After).
LLM_MAX_RETRIES=2
# When the configured provider is unreachable, fall back to the deterministic
# rule-based planner instead of failing the request.
LLM_DEGRADED_FALLBACK=true

# Provider-specific examples (uncomment ONE block):
#
# Groq - free tier, no card, OpenAI-compatible wire format. Served by the
# `openai` provider with a base URL override. Key: console.groq.com/keys
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_replace-me
#
# Ollama - fully local, no key, no network at inference time.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434
#
# Google Gemini - free tier. Key: aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=replace-me
#
# Anthropic. Key: console.anthropic.com
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=replace-me
#
# OpenAI. Key: platform.openai.com
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-replace-me

# --- RAG --------------------------------------------------------------------
DOCUMENT_PATH=./rag/documents
VECTOR_STORE_PATH=./.index/chroma
VECTOR_STORE_COLLECTION=support_corpus
# all-MiniLM-L6-v2 exported to ONNX (~79MB, no PyTorch). Cached under
# EMBEDDING_CACHE_DIR after first use so the container starts offline.
EMBEDDING_MODEL=all-MiniLM-L6-v2-onnx
EMBEDDING_CACHE_DIR=./.index/models
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
# Hybrid retrieval weight: 1.0 = pure dense, 0.0 = pure BM25.
RAG_DENSE_WEIGHT=0.6
# Below this fused score the copilot reports low confidence instead of
# answering. Measured: on-topic 0.53-0.65, off-topic 0.05-0.26.
RAG_MIN_SCORE=0.32
